{
    "image": "mcr.microsoft.com/devcontainers/miniconda",
    "containerEnv": {
        "PYTHONPATH": "${PYTHONPATH}:/workspaces/crystALL"
    },
    "customizations": {
      "codespaces": {
        "openFiles": [
          "notebooks/README.md"
        ]
      },
      "vscode": {
        "extensions": [
          "wijmo.gc-excelviewer",
          "mechatroner.rainbow-csv",
          "ms-python.python",
          "ms-toolsai.jupyter",
          "hansvn.instant-mongo"
        ]
      }
    },
    "hostRequirements": {
       "cpus": 4,
       "memory": "16gb",
       "storage": "16gb"
    },
    "onCreateCommand": "conda install -y python=3.12 && pip install 'dgl>=2.2.0' -f https://data.dgl.ai/wheels/torch-2.3/repo.html && python -m pip install -r requirements.txt"
}