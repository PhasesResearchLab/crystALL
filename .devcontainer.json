{
  "image": "ghcr.io/ricardonpa/crystall:latest",
  "containerEnv": {
    "PYTHONPATH": "${PYTHONPATH}:/workspaces/crystALL",
    "DGLBACKEND": "pytorch"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPortsSource": "process",
        "remote.localPortHost": "localhost"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "hansvn.instant-mongo"
      ]
    },
    "codespaces": {
      "openFiles": [
        "tutorial/README.md"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "16gb"
  },
  "postCreateCommand": "pip install yaspin"
}